{
  "name": "duel",
  "version": "0.1.0",
  "description": "Collaborative coding platform with real-time pair programming and AI mentorship",
  "private": true,
  "workspaces": [
    "services/*",
    "web",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:executor\" \"npm run dev:web\"",
    "dev:executor": "cd services/code-executor && npm run dev",
    "dev:web": "cd web && npm run dev",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "setup": "npm install && npm run docker:up"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "tailwindcss": "3.4.13",
    "@tailwindcss/node": "0.0.0",
    "@tailwindcss/postcss": "0.0.0"
  },
  "keywords": [
    "coding-platform",
    "pair-programming",
    "collaborative-coding",
    "leetcode",
    "competitive-programming",
    "code-execution",
    "ai-learning"
  ],
  "author": "Nikunj"
}
